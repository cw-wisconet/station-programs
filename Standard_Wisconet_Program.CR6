'Program Name:     TEST-5a.cr6
'Program Author:   Caitlin Wienkes
'Acknowledgements: based on code provided by Steve Marquie; see previous versions for detailed notes
'Date:             January 2024
'
'Info:             data logger program ID code: [stid]-[1][2].[prg]: where:
'                        [stid]...station id:         [XXXX]
'                        [1]...# of Soil sensors      [#]    (5=full suite, 4=5,10,20,50 cm, 3=5,10,20cm...)
'                        [2]...LWS_canopy             [x]    (a=no, b=yes)
'                        [prg]...suffix/logger type  [cr6]   (cr6=CR6)
'
''version 0.3_2024
'
'Comments:         SDI-12 Instructions based on sample code provided by CSI (B. Banham)
'                  Program assumes modem is powered-on continuously
'
'------------------------------------------------------------------------------------------------------------------------------------------
'
'------------------------------------------------------------------------------------------------------------------------------------------
'Wiring Diagram:
'
'CR6     HMP155a                               CR6        LI200R-SMV
'  G       Red                                   U9          Black
'  AGND    Green                                 U10         Red
'  G       Black   (Shield)
'  U7      Yellow  (Relative Humidity Signal)
'  U8      White   (Temperature Signal)
'  12V     Blue
' Wires not used: Pink, Brown, and Grey
' Separate G and AGND
'
'CR6      LWS_Standard                         CR6        LWS_Canoppy (Door and Kewaunee Stations)
'  U1       Brown  (VEx)                         U1         White (VEx)
'  U2       Orange (Signal)                      U3         Red   (Signal)
'  G        Clear  (Gnd)                         G          Clear
'
'CR6      CS655                                CR6        03002
'  G        Black                                G          Black
'  G        Clear (Shield)                       G          Clear   (Shield)
'  C3       Green (Signal)                       G          White
'  12V      Red                                  U1         Blue    (VEx)
'  Wire not used: Orange                         U4         Green   (Direction Signal)
'                                                U6         Red     (Speed Signal)
'
'CR6      TE525                                CR6        BaroVUE
'  G        White                                G          Black
'  U5       Black (Signal)                       C1         White  (Signal)
'  G        Clear (Shield)                       12V        Red
'
'
'------------------------------------------------------------------------------------------------------------------------------------------
'Declare Constants:
'
'   The following are station-specific variables:
'
Const ELEV = 315                                    'ELEV: Station Elevation - Used to convert station pressure to sea level pressure
'
'   The following are program constants and should not be modified
'
Const MMWIN = 3600                                  'MMWIN:     Maximum Maintenance Window (in seconds) [3600 = one hour]
Const LWET = 280                                    'LWET:      Leaf wetness - cutoff between wet/dry (e.g. 280 mV)
Const MAIN_SCAN = 3                                 'MAIN_SCAN: Primary Scan Rate, in seconds (e.g. 3)...    used for main program and most sensors
Const SUB_SCAN1 = 5                                 'SUB_SCAN1: SlowSequence #1 Scan Rate, in seconds (e.g. 5)... used for slower sensors; used to improve "skipped scans"
Const SUB_SCAN2 = 60                                'SUB_SCAN2: SlowSequence #2 Scan Rate, in seconds (e.g. 60)... used for slower sensors; used to improve "skipped scans"
Const SUB_SCAN3 = 30                               'SUB_SCAN3: SlowSequence #2 Scan Rate, in seconds (e.g. 300)... used for slower sensors; used to improve "skipped scans"
'
'
''Send data through to NM10 IP address using FTPClient
'
Const IPAddress="0.0.0.0"
Const UserName="ABC"
Const Password="123"
'
''------------------------------------------------------------------------------------------------------------------------------------------
'Declare Variables and Units
'
Public CurrentTime(9)                       'Date/Time Info from Logger
Public Battery_V                            'Logger Battery Voltage
Public PanelTemp_C                          'Logger Wiring Panel Temperature
Public ModuleState As Boolean
'
Public AirTemp_C                            'HMP-155a Air Temperature
Public RelHum                               'HMP-155a Relative Humidity
'
Public SolRad_W                             'Solar Radiation: Flux Density
Public SolRad_kJ                            'Solar Radiation: Total Flux
Public SolRad_kWh                           'Solar Radiation: Total Flux
'
Public CS650_0(6)                           'CS655 Water Content Reflectometer / Soil Temperature (05-cm)    [SDI-12 sensor address "0"]
Public CS650_1(6)                           'CS655 Water Content Reflectometer / Soil Temperature (10-cm)    [SDI-12 sensor address "1"]
Public CS650_2(6)                           'CS655 Water Content Reflectometer / Soil Temperature (20-cm)    [SDI-12 sensor address "2"]
Public CS650_3(6)                           'CS655 Water Content Reflectometer / Soil Temperature (50-cm)    [SDI-12 sensor address "3"]
Public CS650_4(6)                           'CS655 Water Content Reflectometer / Soil Temperature (100-cm)   [SDI-12 sensor address "4"]
'
Public BaroVUE(3)                           'BaroVUE barometric pressure sensor (enclosure mounted)
'
Public Rain_mm                              'Precipitation
'
Public LW_Standard_mV                       'Leaf Wetness (LWS-L): Standard Mount
Public LW_Canopy_mV
'
Public WindDir_3m                           'Wind Direction: 3m
Public WindSpd_ms_3m                        'Wind Speed: 3m
'
Public Main_Count                           'Test Counter for Outer Primary Loop
Public SubScan1_Count                       'Test Counter For SubScan #1
Public SubScan2_Count                       'Test Counter For SubScan #2
Public SubScan3_Count                       'Test Counter For SubScan #3
'
Public FTPResult                            'Status of FTP file transfer
'Public HTTPResponse
'Public http_header_content As String * 100
'
' Maintenance Mode Variables - developed by S. Marquie
'
'   - to treat logger restarts as 'maintenance' event, set the "Table**_Enabled"
'     boolean variables to "False", otherwise set to "True"
'
Public MaintMode As Boolean = False         'boolean flag used to control Maintenance Mode (T => enabled, F => disabled)
Dim    MaintCounter As Long = 0             'maintenance window counter... used to determine timeout for Maintenance Mode
Dim    VarDisabled As Boolean = False       'boolean flag used to determine if measurement is included in output saved to Data Table
'
Dim    Table05_Enabled As Boolean = True   'boolean flag used to control if Data Table "Table5" should be processed /output
'
'-----------------------------------------------------------------
'
Alias CurrentTime(9)=DayOfYear               'Current Day of Year
'
Alias CS650_0(1)=SoilMstr_5cm               'Soil Moisture (Volumetric Water Content): 5cm
Alias CS650_0(2)=SoilEC_5cm                 'Soil Electrical Conductivity: 5cm
Alias CS650_0(3)=SoilTemp_C_5cm             'Soil Temperature: 5cm
Alias CS650_0(4)=SoilBDP_5cm                'Soil Bulk Dielectric Permittivity: 5cm
Alias CS650_0(5)=SoilPA_5cm                 'Soil Period Average: 5cm
Alias CS650_0(6)=SoilVR_5cm                 'Soil Voltage Ratio: 5cm
Alias CS650_1(1)=SoilMstr_10cm              'Soil Moisture (Volumetric Water Content): 10cm
Alias CS650_1(2)=SoilEC_10cm                'Soil Electrical Conductivity: 10cm
Alias CS650_1(3)=SoilTemp_C_10cm            'Soil Temperature: 10cm
Alias CS650_1(4)=SoilBDP_10cm               'Soil Bulk Dielectric Permittivity: 10cm
Alias CS650_1(5)=SoilPA_10cm                'Soil Period Average: 10cm
Alias CS650_1(6)=SoilVR_10cm                'Soil Voltage Ratio: 10cm
Alias CS650_2(1)=SoilMstr_20cm              'Soil Moisture (Volumetric Water Content): 20cm
Alias CS650_2(2)=SoilEC_20cm                'Soil Electrical Conductivity: 20cm
Alias CS650_2(3)=SoilTemp_C_20cm            'Soil Temperature: 20cm
Alias CS650_2(4)=SoilBDP_20cm               'Soil Bulk Dielectric Permittivity: 20cm
Alias CS650_2(5)=SoilPA_20cm                'Soil Period Average: 20cm
Alias CS650_2(6)=SoilVR_20cm                'Soil Voltage Ratio: 20cm
Alias CS650_3(1)=SoilMstr_50cm              'Soil Moisture (Volumetric Water Content): 50cm
Alias CS650_3(2)=SoilEC_50cm                'Soil Electrical Conductivity: 50cm
Alias CS650_3(3)=SoilTemp_C_50cm            'Soil Temperature: 50cm
Alias CS650_3(4)=SoilBDP_50cm               'Soil Bulk Dielectric Permittivity: 50cm
Alias CS650_3(5)=SoilPA_50cm                'Soil Period Average: 50cm
Alias CS650_3(6)=SoilVR_50cm                'Soil Voltage Ratio: 50cm
Alias CS650_4(1)=SoilMstr_100cm              'Soil Moisture (Volumetric Water Content): 100cm
Alias CS650_4(2)=SoilEC_100cm                'Soil Electrical Conductivity: 100cm
Alias CS650_4(3)=SoilTemp_C_100cm            'Soil Temperature: 100cm
Alias CS650_4(4)=SoilBDP_100cm               'Soil Bulk Dielectric Permittivity: 100cm
Alias CS650_4(5)=SoilPA_100cm                'Soil Period Average: 100cm
Alias CS650_4(6)=SoilVR_100cm                'Soil Voltage Ratio: 100cm
'
Alias BaroVUE(1)=BV_BP                      ' Barometric Pressure
Alias BaroVUE(2)=BV_Temp                    ' Temperature correction of BP
Alias BaroVUE(3)=BV_Qual                    ' BP Sensor Quality Assessment
'
'-----------------------
'
Units Battery_V=Volts
Units PanelTemp_C=Deg C
'
Units AirTemp_C=Deg C
Units RelHum=%
'
Units SolRad_W=W/m2
Units SolRad_kJ=kJ/m2
Units SolRad_kWh=kWh
'
Units Rain_mm=mm
'
Units LW_Standard_mV=mV
Units LW_Canopy_mV=mV
'
Units SoilBDP_5cm=unitless
Units SoilBDP_10cm=unitless
Units SoilBDP_20cm=unitless
Units SoilBDP_50cm=unitless
Units SoilBDP_100cm=unitless
Units SoilEC_5cm=dS/m
Units SoilEC_10cm=dS/m
Units SoilEC_20cm=dS/m
Units SoilEC_50cm=dS/m
Units SoilEC_100cm=dS/m
Units SoilMstr_5cm=m^3/m^3
Units SoilMstr_10cm=m^3/m^3
Units SoilMstr_20cm=m^3/m^3
Units SoilMstr_50cm=m^3/m^3
Units SoilMstr_100cm=m^3/m^3
Units SoilPA_5cm=nsec
Units SoilPA_10cm=nsec
Units SoilPA_20cm=nsec
Units SoilPA_50cm=nsec
Units SoilPA_100cm=nsec
Units SoilTemp_C_5cm=Deg C
Units SoilTemp_C_10cm=Deg C
Units SoilTemp_C_20cm=Deg C
Units SoilTemp_C_50cm=Deg C
Units SoilTemp_C_100cm=Deg C
Units SoilVR_5cm=unitless
Units SoilVR_10cm=unitless
Units SoilVR_20cm=unitless
Units SoilVR_50cm=unitless
Units SoilVR_100cm=unitless
'
Units BV_BP=hPa
Units BV_Temp=deg C
Units BV_Qual=unitless
'
Units WindDir_3m=degrees from North
Units WindSpd_ms_3m=meters/sec
'
'------------------------------------------------------------------------------------------------------------------------------------------
'------------------------------------------------------------------------------------------------------------------------------------------
'Define Data Tables:   (Note: Array ID, date, and time info set within LoggerNet Settings)
'
'   NOTE: process Data Table only in "TableLogging" is set to "True"
'   NOTE: include measured data only if "VarDisabled" is set to "False"
'
'   --- Table5 (Five Minute Data) ---
'
'   00: Array ID (configured within LoggerNet Data Collection)
'   01: Year (configured within LoggerNet Data Collection)
'   02: Day (configured within LoggerNet Data Collection)
'   03: Hour-Minute (configured within LoggerNet Data Collection)
'   04: Battery Voltage (average)
'   05: Air Temperature [2.0m] (average)
'   06: Relative Humidity [2.0m] (average)
'   07: Solar Radiation [2.5m] (average)
'   08: Solar Radiation [2.5m] (total kJ)
'   09: Solar Radiation [2.5]  (total kWh)
'   10: Barometric Pressure [1.5m] (average)
'   11: Precipitation (total)
'   12: Leaf Wetness LWS Standard (average)
'   13: Leaf Wetness LWS Canopy (average)
'   14: Wind Speed [3m] (average)
'   15: Wind Gust [3m] (maximum)
'   16: Wind Dir [3m] (average)
'   17: Soil Temperature [5cm] (average)
'   18: Soil Temperature [10cm] (average)
'   19: Soil Temperature [20cm] (average)
'   20: Soil Temperature [50cm] (average)
'   21: Soil Temperature [100cm] (average)
'   22: Soil Moisture [5cm] (average)
'   23: Soil Moisture [10cm] (average)
'   24: Soil Moisture [20cm] (average)
'   25: Soil Moisture [50cm] (average)
'   26: Soil Moisture [100cm] (average)
'
DataTable(Table5, Table05_Enabled, -1)
  DataInterval(0, 5,Min, 10)
  Average(1, Battery_V, FP2,False)
  Average(1, AirTemp_C, FP2,False)
  Average(1, RelHum, FP2,False)
  Average(1,SolRad_W,FP2,False)
  Totalize(1,SolRad_kJ,FP2,False)
  Totalize(1,SolRad_kWh,FP2,False)
  Average(1, BV_BP,IEEE4, False)
  Totalize(1, Rain_mm, FP2,False)
  Average(1, LW_Standard_mV, FP2,False)
  Average(1, LW_Canopy_mV, FP2,False)
  Average(1, WindSpd_ms_3m, FP2,False)
  Maximum(1, WindSpd_ms_3m, FP2,False, True)
  Average(1,WindDir_3m,FP2,False)
  Average(1,SoilMstr_5cm,FP2,False)
  Average(1,SoilTemp_C_5cm,FP2,False)
  Average(1,SoilMstr_10cm,FP2,False)
  Average(1,SoilTemp_C_10cm,FP2,False)
  Average(1,SoilMstr_20cm,FP2,False)
  Average(1,SoilTemp_C_20cm,FP2,False)
  Average(1,SoilMstr_50cm,FP2,False)
  Average(1,SoilTemp_C_50cm,FP2,False)
  Average(1,SoilMstr_100cm,FP2,False)
  Average(1,SoilTemp_C_100cm,FP2,False)
  Sample(1,Table05_Enabled,Boolean)                 'Variable used for Maintenance Mode
EndTable

'------------------------------------------------------------------------------------------------------------------------------------------
'Main Program
BeginProg
  Main_Count = 0
  SubScan1_Count = 0
  '------------------------------------------------------------------------------------------------------------------
  'Main Scan
  '------------------------------------------------------------------------------------------------------------------
  Scan(MAIN_SCAN,Sec, 1, 0)
    Main_Count = Main_Count + 1
    '----------------------------------------
    '--- determine Current Time
    '----------------------------------------
    RealTime(CurrentTime)
    '----------------------------------------------
    '--- determine CR6 Dataloger Battery Voltage
    '----------------------------------------------
    Battery(Battery_V)
    '--------------------------------------------------------
    '--- determine CR6 Datalogger Wiring Panel Temperature
    '--------------------------------------------------------
    PanelTemp(PanelTemp_C, 60)
    '
    '
    '--------------------------------------------------------------------------------------------
    'HMP155 (constant power) Temperature & Relative Humidity Sensor measurements 'AirTC' and 'RH'
    '--------------------------------------------------------------------------------------------
    VoltSe(AirTemp_C,1,mV1000,U8,False,0,60,0.14,-80)
    VoltSe(RelHum,1,mV1000,U7,False,0,60,0.1,0)
    If RelHum>100 AND RelHum<108 Then RelHum=100
    '
    '-----------------------------------------
    '--- measure Precipitation   (TE525)
    '-----------------------------------------
    PulseCount(Rain_mm, 1, U5, 1, 0, 0.254, 0)

    '----------------------------------------
    '--- measure Leaf Wetness   (LWS-L)
    '----------------------------------------
    '
    '      (1) Standard Leaf Wetness
    BrHalf(LW_Standard_mV, 1, mV5000, U2, U1, 1, 2500, False, 10000, 60, 2500, 0)
    '
    '---   (2) Canopy Leaf Wetness
    BrHalf(LW_Canopy_mV, 1, mV5000, U3, U1, 1, 2500, False, 10000, 60, 2500, 0)
    '
    '---------------------------------------
    '--- measure Wind Speed / Wind Direction
    '---------------------------------------
    '---
    '---   (1) Wind Speed / Wind Direction: 3m   (RM Young 3002)
    '---
    PulseCount(WindSpd_ms_3m, 1, U6, 5, 1, 0.75, 0.2)                           'mult=0.75, offset=0.2 => meters/sec (from ShortCut 4.4)
    If (WindSpd_ms_3m < 0.21) Then                                              'adjust for minimum/offset (from ShortCut 4.4)
      WindSpd_ms_3m = 0
    EndIf
    BrHalf(WindDir_3m, 1, mV5000, U4, U1, 1, 2500, True, 20000, 60, 352, 0)     'measurment range=mV5000, excitation voltage=2500mV, multiplier=352
    If (WindDir_3m >= 352 OR WindDir_3m < 0) Then                               'adjust for sensor 'dead zone' (from ShortCut 4.4)
      WindDir_3m = 0
    EndIf
    '
    '----------------------------------------
    '--- Measure Solar Radiation
    '----------------------------------------
    '
    VoltDiff(SolRad_W,1,mV200,U9,True,0,60,-100,0)
    If SolRad_W<0 Then SolRad_W=0
    'Calculate total flux
    'The multiplier to calculate total flux was calculated by Short Cut
    'and based on a program execution rate (scan rate) of 5 Seconds.
    'If you change the program execution rate outside of Short Cut with the CRBasic Editor
    'you will need to recalculate this multiplier. See the sensor manual for more details.
    SolRad_kJ=SolRad_W*MAIN_SCAN/1000
    SolRad_kWh=(SolRad_W*MAIN_SCAN)/(1000*3600)
    '
    '----------------------------------------
    '--- Modem Control
    '----------------------------------------
    '---   - not needed... program assumes modem is powered "on" continuously
    '---

    '---   - reset test counters
    If (TimeIntoInterval(0, 60, min)) Then
      Main_Count = 0
      SubScan1_Count = 0
      SubScan2_Count = 0
    EndIf


    '--------------------------------------------------------
    '--- Call Data Tables and Store/Output Data
    '--------------------------------------------------------
    '---                                                       'One-Minute Output
    CallTable Table5                                                       'Five-Minute Output
    '---
    '---   (2) set data table processing flags (i.e. check for "maintenance mode"
    '---       - MaintMode = True  (enabled... process data tables)
    '---       - MaintMode = False (disabled... do not process data tables)
    '---
    '---         - added checks to:
    '---             (a) disable next five-minute entry after maintenance mode ends
    '---
    If (MaintMode = True) Then                                             'If "Maintenance Mode" is enabled (i.e. True)...
      MaintCounter = MaintCounter + 1                                     '...increment maintenance window counter by 1
      Table05_Enabled = False                                             '...during maintenance mode, do not process Data Table "Table5"
      VarDisabled = True                                                  '...during maintenance mode, do not include measurements in Data Table Commands
      If (MaintCounter > MMWIN / MAIN_SCAN) Then                          '...once maintenance mode threshold has been reached (maintenance window / main scan rate)...
        MaintMode = False                                                '   ...reset boolean to disable "maintenance mode" and resume processing of data tables
      EndIf
    EndIf

    If (MaintMode = False) Then                                            'If "Maintenance Mode" is disabled (i.e. False)...
      MaintCounter = 0                                                    '...keep maintenance windows counter at 0 (until in maintenance mode)

      Table05_Enabled = True                                           '...wait until next 05-minute period to re-enable 05-minute data table (if needed)

      VarDisabled = False
    EndIf
    

    '----------------------------------------------
    'Power cycle CELL210
    '----------------------------------------------
    'Between the hours of 4:00 and 23:00, turn the CELL200 series on
    'If TimeIsBetween(4,23,24,Hr) Then
     ' ModuleState=True
      'IPNetPower(5,1)
    'Else
    ModuleState=True
    If ModuleState=False
      IPNetPower(5,0)
    EndIf
    
    
  NextScan
  '
  '---------------------------------------------
  '--- Slow Sequence Scan #1   (e.g. 5 seconds)
  '---------------------------------------------
  '---
  '
  SlowSequence
  Scan(SUB_SCAN1, Sec, 3, 0)
    '
    SubScan1_Count = SubScan1_Count + 1
    '       Default CR6 Datalogger Battery Voltage measurement 'BattV'
    Battery(Battery_V)
    'Default CR6 Datalogger Wiring Panel Temperature measurement 'PTemp_C'
    PanelTemp(PanelTemp_C ,60)
    '
    '---------------------------------------------------------
    '--- measure Barometric Pressure
    '---------------------------------------------------------
    '
    'BaroVUE10 (SDI-12) Barometric Pressure Sensor measurements 'BV_BP', 'BV_Temp', and 'BV_Qual'
    SDI12Recorder(BaroVUE(),C1,"2","M!",1,0,-1)
    'Correct BaroVUE10 (SDI-12) Barometric Pressure Sensor 'BV_BP' measurement from station pressure to sea level pressure
    BV_BP=BV_BP+1013.25*(1-(1-ELEV/44307.69231)^5.25328)
    '

    '
  NextScan
  '
  '---------------------------------------------
  '--- Slow Sequence Scan #2   (e.g. 60 seconds)
  '---------------------------------------------
  '---
  '---
  SlowSequence
  Scan(SUB_SCAN1, Sec, 3, 0)

    SubScan2_Count = SubScan2_Count + 1

    '--------------------------------------------
    '--- measure Soil Temperature / Soil Moisture
    '--------------------------------------------
    '---
    '---   (1) Soil Temperature / Soil Moisture: 05cm   (SDI12: CS650)
    '---
    SDI12Recorder(CS650_0(), C3, "0", "M4!", 1, 0, -1)
    '---
    '---   (2) Soil Temperature / Soil Moisture: 10cm   (SDI12: CS650)
    '---
    SDI12Recorder(CS650_1(), C3, "1", "M4!", 1, 0, -1)
    '---
    '---   (3) Soil Temperature / Soil Moisture: 20cm   (SDI12: CS650)
    '---
    SDI12Recorder(CS650_2(), C3, "2", "M4!", 1, 0, -1)
    '---
    '---   (4) Soil Temperature / Soil Moisture: 50cm   (SDI12: CS650)
    '---
    SDI12Recorder(CS650_3(), C3, "3", "M4!", 1, 0, -1)
    '---
    '---   (5) Soil Temperature / Soil Moisture: 100cm   (SDI12: CS650)
    '---
    SDI12Recorder(CS650_4(), C3, "4", "M4!", 1, 0, -1)
    '
  NextScan

  SlowSequence
  Scan(SUB_SCAN3, Sec, 3, 0)

    SubScan3_Count = SubScan3_Count + 1
    '--------------------------------------------
    '--- Establish an FTP Connection to the NM10 Server
    '--------------------------------------------
    'Create file named TEST_Table5_MMDDYYY.csv every 5 minutes
    'File format is TOA5 with timestamp & record number
    'subsequent writes will not include header info unless the file has been
    'deleted (12 is the file format option; 1000 indicates static file name;
    'negating value means do not write header with each write of new data)
    '
    FTPResult = FTPClient (IPAddress,UserName,Password,"Table5","TEST_Table5_" & CurrentTime(1)& CurrentTime(2)& CurrentTime(3)& CurrentTime(4)& CurrentTime(5)& ".csv",20,0,5,Min,-1012)
   
  NextScan
    
    'http_header_content = "Content-Type:application/json"
    'HTTPPost ("https://dev.wisconet.wisc.edu/station_update.php","Table5",HTTPResponse,http_header_content,0,5,Min,32)
  '
  '
EndProg
'------------------------------------------------------------------------------- ---------------------------------------
'
'----------------------------------------------------------------------------------------------------------------------
